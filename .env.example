# ============================================================================
# MemoryBrain — modèle de configuration.
#
#   cp .env.example .env      puis adaptez les chemins à votre machine.
#
# Ce fichier-ci est versionné (il ne contient aucune valeur personnelle) ;
# le fichier `.env` ne l'est jamais. Si vous ne créez pas `.env`, le programme
# utilise les valeurs par défaut indiquées à droite : tout fonctionne sans
# configuration, dans un dossier standard de votre compte.
#
# Les variables peuvent aussi être exportées à la main :
#   export MEMORYBRAIN_VOIX=/chemin/vers/mes/enregistrements
# ============================================================================

# --- Dossiers (aucun n'est dans le dépôt) -----------------------------------

# Dossier d'entrée de l'audio : c'est là que votre outil de synchronisation
# dépose les fichiers. Nom et emplacement libres.
# Défaut : ./syncthing-inbox, à côté de config.py
MEMORYBRAIN_INBOX=

# Enregistrements dont on est SÛR qu'ils sont de la personne propriétaire du
# micro. C'est la seule base du profil vocal : n'y mettez rien d'autre.
# Défaut : ~/.local/share/memorybrain/reference
MEMORYBRAIN_VOIX=

# Racine des fiches écrites (le "socle" de notes markdown).
# Défaut : ~/.local/share/memorybrain
MEMORYBRAIN_SOCLE=

# Dossier de quarantaine : rien n'y est supprimé, on y déplace.
# Défaut : ~/.local/share/memorybrain/corbeille
MEMORYBRAIN_CORBEILLE=

# Dossier de quarantaine de l'ancienne chaîne (copies de travail, jamais de
# suppression). Défaut : ~/.local/share/memorybrain/quarantaine
MEMORYBRAIN_POUBELLE=

# Dossier des fiches markdown à alimenter (facultatif).
# Défaut : ~/.local/share/memorybrain/wiki
MEMORYBRAIN_WIKI=

# Modèle de diarisation Nemotron au format GGUF, si vous en utilisez un autre.
# Défaut : sous ~/.local/share/memorybrain/models/ (aucun modèle livré)
MEMORYBRAIN_NEMOTRON_DIAR=

# --- Secret -----------------------------------------------------------------
# Jeton Hugging Face, uniquement si vous utilisez pyannote pour la diarisation.
# Laissez vide pour le moteur local (recommandé).
HF_TOKEN=

# --- Répartition du travail -------------------------------------------------

# Durée (secondes) après laquelle un job confié à un worker est repris.
# Défaut : 1800
MB_HUB_DELAI=

# Dossier du paquet qui expose l'application Celery du hub (hors dépôt).
# Défaut : ~/.local/share/memorybrain-hub
MEMORYBRAIN_HUB_DIR=

# Nom du worker à cibler quand un job doit voir les fichiers du corpus.
# Défaut : localhost (la machine locale)
MEMORYBRAIN_WORKER=

# Binaire du runtime de diarisation local.
# Défaut : ~/.local/bin/nemo-speech
MEMORYBRAIN_NEMO_SPEECH=

# --- Modèle de langue (extraction) -----------------------------------------

# Port du serveur OpenAI-compatible local.
# Défaut : 8000
MEMORYBRAIN_PORT=

# Nom du modèle demandé au serveur. Un seul serveur est déclaré : aucun
# autre service n'est interrogé en repli.
# Défaut : chocolatine-2-4b
MEMORYBRAIN_LLM_MODELE=

# Numéro de ce worker et nombre total de workers. Un seul worker : laissez 1/1.
MB_WORKER=1
MB_TOTAL_WORKERS=1

# Nombre maximum de groupes traités par ce worker (utile pour un test à blanc).
MB_GROUPES=9999

# Base SQLite propre à ce worker. Vide = dérivée de config.DB_PATH.
MB_BASE=

# Écriture des fiches par un modèle de langue. 0 = désactivé, 1 = activé.
MB_LLM=1
